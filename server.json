{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.RudrenduPaul/agent-eval",
  "description": "Statistical regression testing for LLM agents: p-value, effect size, and CI on behavior change.",
  "repository": {
    "url": "https://github.com/RudrenduPaul/agent-eval",
    "source": "github"
  },
  "version": "0.1.8",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "agent-regress-cli",
      "version": "0.1.8",
      "runtimeHint": "uvx",
      "runtimeArguments": [
        {
          "type": "named",
          "name": "--from",
          "value": "agent-regress-cli"
        }
      ],
      "packageArguments": [
        {
          "type": "positional",
          "valueHint": "script_name",
          "value": "agent-regress-mcp"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
